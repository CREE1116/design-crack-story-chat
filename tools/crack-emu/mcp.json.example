{
  "mcpServers": {
    "crack-emu": {
      "command": "python3",
      "args": [
        "-m", "crack_emulator",
        "--project", "/절대/경로/내프로젝트/build",
        "--store", "/절대/경로/.crack-emu/sessions",
        "mcp",
        "--key-file", "/절대/경로/저장소밖/crack-keys.json"
      ],
      "env": { "PYTHONPATH": "/절대/경로/design-crack-story-chat/tools/crack-emu" }
    }
  }
}
